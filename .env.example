# Caspian API key (get one: POST https://api.trycaspianai.com/v1/projects/sandbox)
CASPIAN_API_KEY=comm_sandbox_your_key_here
CASPIAN_BASE_URL=https://api.trycaspianai.com

# Telegram bot token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI-compatible LLM (use Featherless $25 credit, or your own key)
OPENAI_API_KEY=your_llm_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Email account for victim communication (generated by connect_email)
BODYGUARD_USERNAME=bodyguard
